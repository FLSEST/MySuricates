{
  "name": "mysuricates-frontend",
  "private": true,
  "version": "0.7.8",
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:e2e:test": "CYPRESS_TARGET=test vite",
    "build": "tsc -b && vite build && node scripts/check-lazy-chunks.mjs",
    "preview": "vite preview",
    "lint": "eslint .",
    "cy:open": "cypress open",
    "cy:open:test": "CYPRESS_TARGET=test cypress open",
    "cy:run": "cypress run",
    "cy:run:test": "CYPRESS_TARGET=test cypress run",
    "test:e2e": "cypress run",
    "test:e2e:test": "CYPRESS_TARGET=test cypress run",
    "pw:install": "npx playwright install chromium",
    "test:templates": "npx playwright test",
    "test:templates:shell": "npx playwright test --project=shell-templates",
    "test:templates:ai": "npx playwright test --project=simple-ai-templates",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.1.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@monaco-editor/react": "^4.6.0",
    "@stomp/stompjs": "^7.3.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tanstack/react-query": "^5.103.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "fuse.js": "^7.5.0",
    "lucide-react": "^1.47.0",
    "monaco-editor": "^0.57.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1",
    "remark-gfm": "^4.0.1",
    "sockjs-client": "^1.6.1",
    "zustand": "^5.0.15"
  },
  "overrides": {
    "dompurify": "^3.4.16",
    "serialize-javascript": "^7.1.2",
    "lodash": "^4.18.1",
    "websocket-driver": "0.7.5",
    "@babel/plugin-transform-runtime": "^7.29.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sockjs-client": "^1.5.4",
    "@vitejs/plugin-react": "^6.1.1",
    "cypress": "^16.1.0",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^14.0.0",
    "jsdom": "^30.1.0",
    "msw": "^2.15.0",
    "postcss": "^8.5.10",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.1"
  }
}
