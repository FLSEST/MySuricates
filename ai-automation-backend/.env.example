# MySuricates Backend — Beispiel-Konfiguration
#
# WICHTIG: Spring Boot liest diese Datei NICHT automatisch.
# Es gibt keine dotenv-Abhaengigkeit im Projekt und kein env_file: in den Compose-Dateien.
# Diese Datei ist eine Referenz, keine Auto-Konfiguration. Zwei Wege, sie zu benutzen:
#
#   Host-Start:  set -a; . ./.env; set +a    (danach mvn spring-boot:run bzw. java -jar)
#   Compose:     docker compose liest eine .env neben der Compose-Datei nur fuer die
#                ${VAR}-Ersetzung IN der Compose-Datei. Was im Container ankommt, steht
#                unter environment: — dort muss die Variable also aufgefuehrt sein.
#
# Alle Werte unten sind die tatsaechlichen Defaults aus src/main/resources/application.yml.
# Auskommentiert = Default gilt. Nur eintragen, was du wirklich aenderst.
#
# Die automation.*-Konfiguration wird ueber @ConfigurationProperties gebunden. Spring bindet
# jede Property zusaetzlich direkt aus der passenden Umgebungsvariablen, auch wenn in
# application.yml kein ${...}-Platzhalter dafuer steht (z. B. AUTOMATION_HOST_CLAUDE_MAX_TOKENS
# -> automation.host-claude.max-tokens). Umgebungsvariablen haben Vorrang vor application.yml.

# ---------------------------------------------------------------------------
# Server und TLS
# ---------------------------------------------------------------------------
#AUTOMATION_PORT=9090
#AUTOMATION_SSL_ENABLED=false
#AUTOMATION_SSL_KEYSTORE=./certs/dev.p12
# Dev-Default eines selbst-signierten Keystores. Fuer echtes TLS eigenen Wert setzen und
# das Zertifikat mit demselben Wert erzeugen (scripts/generate-dev-cert.sh).
# SslPasswordGuard verweigert den Start, wenn AUTOMATION_SSL_ENABLED=true UND dieses Passwort
# noch der Default "mysuricates" ist (IllegalStateException beim Boot). Bei SSL aus bleibt der
# Default weiterhin erlaubt.
#AUTOMATION_SSL_PASSWORD=mysuricates

# ---------------------------------------------------------------------------
# Datenbank
# ---------------------------------------------------------------------------
# SQLite, WAL-Modus, Connection-Pool fest auf 1 (SQLite kennt nur einen Schreiber).
#AUTOMATION_DB_PATH=./data/automation.db

# ---------------------------------------------------------------------------
# Sicherheit
# ---------------------------------------------------------------------------
# Leer lassen -> beim ersten Start wird ein Schluessel erzeugt, im Log ausgegeben und in
# ~/.autotrigger/api-key sowie in der Tabelle app_settings abgelegt.
# ACHTUNG: Ist der wirksame Schluessel leer UND security.enabled=true, gilt jede Anfrage als
# authentifiziert. Ein leerer Wert schaltet die Authentifizierung also ab, statt sie zu verschaerfen.
#AUTOMATION_API_KEY=
#AUTOMATION_SECURITY_ENABLED=true
#AUTOMATION_TRUSTED_PROXIES=127.0.0.1,::1
#AUTOMATION_RATE_LIMIT_ENABLED=true
#AUTOMATION_RATE_LIMIT_RPM=120
#AUTOMATION_ACTIVITY_LOG_MAX_BYTES=65536

# ---------------------------------------------------------------------------
# Netzwerk
# ---------------------------------------------------------------------------
# CORS ist KEINE Zugriffskontrolle — siehe docs/deployment.md, Vertrauensmodell.
# Der Default enthaelt neben localhost auch Tailscale-Muster. Wer Tailscale nicht nutzt,
# kann die 100.*- und *.tail*.ts.net-Eintraege streichen.
#AUTOMATION_CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://localhost:3000,https://localhost:5173,http://100.*:3000,https://100.*:3000,https://*.tail*.ts.net:*
#AUTOMATION_TAILSCALE_ENABLED=true

# ---------------------------------------------------------------------------
# KI-Provider und CLI-Rechte
# ---------------------------------------------------------------------------
# CLAUDE | CODEX | PI
#AUTOMATION_AI_DEFAULT_PROVIDER=CLAUDE
# true ruft die CLI ohne Rechteabfrage auf — sie laeuft dann unbeaufsichtigt mit den
# Rechten des Benutzers, der das Backend gestartet hat.
#AUTOMATION_CLI_SKIP_PERMISSIONS=true
# Kommaliste erlaubter Werkzeuge. Gesetzt -> skip-permissions entfaellt, die CLI erzwingt die Liste.
#AUTOMATION_CLI_ALLOWED_TOOLS=
# Leer -> aus user.home bzw. id -u ermittelt. Nur fuer Container-Setups noetig.
#AUTOMATION_HOST_HOME=
#AUTOMATION_HOST_UID=

#AUTOMATION_HOST_CLAUDE_TIMEOUT=300
#AUTOMATION_HOST_CLAUDE_INTER_CALL_DELAY_MS=0
#AUTOMATION_HOST_CLAUDE_MAX_CONCURRENT_CALLS=5
#AUTOMATION_HOST_CLAUDE_RESERVED_INTERACTIVE=1
# Ohne Platzhalter in application.yml, per Relaxed Binding trotzdem wirksam.
#AUTOMATION_HOST_CLAUDE_MAX_TOKENS=

#AUTOMATION_HOST_PI_TIMEOUT=300
#AUTOMATION_HOST_PI_INTER_CALL_DELAY_MS=0
#AUTOMATION_HOST_PI_MAX_CONCURRENT_CALLS=5
#AUTOMATION_HOST_PI_RESERVED_INTERACTIVE=1
#AUTOMATION_HOST_PI_BACKEND=anthropic
#AUTOMATION_HOST_PI_THINKING=medium

#AUTOMATION_FACTORY_PROVIDER=CLAUDE
#AUTOMATION_FACTORY_DIR=${user.home}/.autotrigger/factory

# ---------------------------------------------------------------------------
# Ausfuehrung und Sandbox
# ---------------------------------------------------------------------------
#AUTOMATION_MAX_CONCURRENT_RUNS=10
#AUTOMATION_TASK_COMMAND_TIMEOUT=60
#AUTOMATION_GHOST_WATCHDOG_STALE=30
# Serverseitiger Schalter: darf ein Shell-Block mit mount_docker_socket den Socket in einen
# erzeugten Agent-Container bekommen? Unabhaengig vom Socket-Mount der Compose-Datei.
#AUTOMATION_ALLOW_DOCKER_SOCKET_MOUNT=false
#AUTOMATION_ALLOW_EXTRA_MOUNTS=false
# Kommaliste erlaubter Mount-Praefixe, nur wirksam mit ALLOW_EXTRA_MOUNTS=true.
#AUTOMATION_ALLOWED_MOUNT_PREFIXES=

# ---------------------------------------------------------------------------
# Docker
# ---------------------------------------------------------------------------
#DOCKER_HOST=unix:///var/run/docker.sock

# ---------------------------------------------------------------------------
# Scheduler, TodoTrigger, Chains
# ---------------------------------------------------------------------------
#AUTOMATION_TODO_TRIGGER_POLL_MS=300000
# ISO-Zeitpunkt, bis zu dem nicht ausgeloest wird (z. B. 2026-12-24T00:00:00Z). Leer = aktiv.
#AUTOMATION_TODO_TRIGGER_SKIP_UNTIL=
#AUTOMATION_SCHEDULER_SKIP_UNTIL=
#AUTOMATION_SCHEDULER_RESUME_GRACE=5
#AUTOMATION_CHAIN_WORKFLOW_TIMEOUT=180

# ---------------------------------------------------------------------------
# Wish-Pipeline
# ---------------------------------------------------------------------------
#AUTOMATION_WISH_TOTAL_TIMEOUT=120
#AUTOMATION_WISH_WORKFLOW_WAIT=30
#AUTOMATION_WISH_WATCHDOG_ENABLED=true
#AUTOMATION_WISH_WATCHDOG_INTERVAL=120000
#AUTOMATION_WISH_WATCHDOG_STALE=45
#AUTOMATION_WISH_SHELL_TIMEOUT=600
#AUTOMATION_WISH_AGENTIC_TIMEOUT=900
#AUTOMATION_WISH_AGENTIC_ITER_TIMEOUT=900
#AUTOMATION_WISH_AGENTIC_TOTAL_TIMEOUT=3600

# ---------------------------------------------------------------------------
# Backup
# ---------------------------------------------------------------------------
#AUTOMATION_BACKUP_ENABLED=true
#AUTOMATION_BACKUP_CRON=0 0 2 * * *
#AUTOMATION_BACKUP_RETAIN_COUNT=30
#AUTOMATION_BACKUP_DIR=${user.home}/.autotrigger/backups/dev

# ---------------------------------------------------------------------------
# Integrationen und Verzeichnisse
# ---------------------------------------------------------------------------
# Schluesseldatei fuer die Verschluesselung gespeicherter OAuth-Token. Geht sie verloren,
# muessen alle Integrationen neu verbunden werden.
#AUTOMATION_INTEGRATION_KEY_FILE=${user.home}/.autotrigger/integration-encryption.key
#AUTOMATION_DOCS_DIR=../docs
#AUTOMATION_REPORTS_DIR=../reports
#AUTOMATION_WORKSPACE_ROOT=
#AUTOMATION_SUMMARIZATION_DIR=${user.home}/.autotrigger/summarization
#AUTOMATION_SUMMARIZATION_TIMEOUT=120
# UUID des Projekts, unter dem die Plattform ihre eigenen TODOs fuehrt.
#AUTOMATION_AUTOPILOT_PROJECT_ID=

# ---------------------------------------------------------------------------
# Workflow-Pool und Discovery
# ---------------------------------------------------------------------------
#AUTOMATION_POOL_ENABLED=true
#AUTOMATION_POOL_DIR=workflow-pool
#AUTOMATION_DISCOVERY_AUTO_TAGGING_ENABLED=true
#AUTOMATION_DISCOVERY_SEMANTIC_ENABLED=true

# ---------------------------------------------------------------------------
# Staging und Test-Instanz (nur fuer das Drei-Umgebungs-Setup)
# ---------------------------------------------------------------------------
#AUTOMATION_STAGING_COMPOSE=docker-compose.stable.yml
#AUTOMATION_STAGING_CONTAINER=mysuricates-stable
#AUTOMATION_STAGING_FRONTEND=stable-frontend
#AUTOMATION_STAGING_HEALTH_URL=http://localhost:9091/api/v1/system/health
#AUTOMATION_STAGING_BACKEND_DIR=
#AUTOMATION_STAGING_FRONTEND_DIR=
#AUTOMATION_STAGING_AUTO_START=false
#AUTOMATION_TEST_COMPOSE=docker-compose.test.yml
#AUTOMATION_TEST_CONTAINER=mysuricates-test
#AUTOMATION_TEST_HEALTH_URL=http://localhost:8090/api/v1/system/health
#AUTOMATION_TEST_AUTO_START=false

# ---------------------------------------------------------------------------
# Tray-Icon (Desktop-Integration, nur beim Host-Start sinnvoll)
# ---------------------------------------------------------------------------
#AUTOMATION_TRAY_ENABLED=true
#AUTOMATION_TRAY_POLL_MS=15000
#AUTOMATION_WEB_UI_URL=http://localhost:3000
#AUTOMATION_STABLE_URL=http://localhost:9091
