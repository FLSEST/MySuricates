# Analysis tools for the architecture review (TODO 67128699): PMD with its copy-paste detector (CPD,
# Java and TypeScript) and the design rules (complexity per method). Only measurement tools, no
# project toolchain — the workflow runs them in the shell block's tool mode against /workspace (read-only).
FROM eclipse-temurin:21-jre-jammy

RUN useradd -m -u 1000 agent

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl unzip ca-certificates && \
    rm -rf /var/lib/apt/lists/*

# Pinned release; the checksum is the digest GitHub lists for the release asset.
ARG PMD_VERSION=7.28.0
ARG PMD_DIST_SHA256=f974ba571f7bc01c73fffe11bade25fbc1f438698f9e9c00e416e8d65e9fbac2
RUN set -eu; \
    curl -fsSL "https://github.com/pmd/pmd/releases/download/pmd_releases%2F${PMD_VERSION}/pmd-dist-${PMD_VERSION}-bin.zip" \
      -o /tmp/pmd.zip; \
    echo "${PMD_DIST_SHA256}  /tmp/pmd.zip" | sha256sum -c -; \
    unzip -q /tmp/pmd.zip -d /opt; \
    ln -s "/opt/pmd-bin-${PMD_VERSION}/bin/pmd" /usr/local/bin/pmd; \
    rm /tmp/pmd.zip

RUN mkdir -p /home/agent/.cache && chown -R agent:agent /home/agent

ENV HOME="/home/agent"
USER agent
WORKDIR /workspace

# Identity of this Dockerfile for the container overview (TODO 244e5de5): scripts/build-agent-images.sh
# passes its sha256, the backend compares it with its catalog (agent-images.json). Last, so a change
# above still reuses the cached layers; a plain `docker compose build` leaves it empty (shown as unlabeled).
ARG DOCKERFILE_SHA256=
LABEL org.mysuricates.dockerfile-sha256=$DOCKERFILE_SHA256
CMD ["tail", "-f", "/dev/null"]
