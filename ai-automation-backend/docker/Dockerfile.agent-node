FROM node:22-slim

# Create generic agent user - UID is overridden at runtime via --user
RUN userdel -r node 2>/dev/null; useradd -m -u 1000 agent

# Install common tools
RUN apt-get update && apt-get install -y --no-install-recommends \
    git curl jq && \
    rm -rf /var/lib/apt/lists/*

# Prepare Claude CLI directories (binary + config mounted from host)
RUN mkdir -p /home/agent/.claude /home/agent/.local/bin /home/agent/.local/share \
             /home/agent/.cache /home/agent/.config && \
    chown -R agent:agent /home/agent

ENV HOME="/home/agent"
ENV PATH="/home/agent/.local/bin:${PATH}"

USER agent
WORKDIR /workspace

# Identity of this Dockerfile for the container overview (TODO 244e5de5): scripts/build-agent-images.sh
# passes its sha256, the backend compares it with its catalog (agent-images.json). Last, so a change
# above still reuses the cached layers; a plain `docker compose build` leaves it empty (shown as unlabeled).
ARG DOCKERFILE_SHA256=
LABEL org.mysuricates.dockerfile-sha256=$DOCKERFILE_SHA256
# Keep container alive for docker exec
CMD ["tail", "-f", "/dev/null"]
