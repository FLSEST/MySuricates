FROM python:3.12-slim

# Create generic agent user - UID is overridden at runtime via --user
RUN useradd -m -u 1000 agent

# Install common tools
RUN apt-get update && apt-get install -y --no-install-recommends \
    git curl jq && \
    rm -rf /var/lib/apt/lists/*

# Python packages, unpinned on purpose — but never frozen at the first build: a layer taken from the
# cache kept them at that day's versions for good (8b7a39b9). A new PIP_REFRESH value (docker-compose.yml:
# the same AGENT_APT_REFRESH as agent-devops, e.g. the month) installs the current ones.
ARG PIP_REFRESH=
RUN echo "PIP_REFRESH=${PIP_REFRESH:-unset}" && \
    pip install --no-cache-dir anthropic pandas numpy requests beautifulsoup4

# Prepare Claude CLI directories (binary + config mounted from host)
RUN mkdir -p /home/agent/.claude /home/agent/.local/bin /home/agent/.local/share \
             /home/agent/.cache /home/agent/.config && \
    chown -R agent:agent /home/agent

ENV HOME="/home/agent"
ENV PATH="/home/agent/.local/bin:${PATH}"

USER agent
WORKDIR /workspace

CMD ["tail", "-f", "/dev/null"]
