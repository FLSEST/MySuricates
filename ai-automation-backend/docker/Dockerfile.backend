FROM eclipse-temurin:21-jre-alpine

RUN adduser -D -u 1000 appuser

# Tailscale — pinned version + SHA256 verification (no `|| true` masking failures)
ARG TAILSCALE_VERSION=1.96.4
ARG TAILSCALE_AMD64_SHA256=a1cba18826b1f91cb25ef7f5b8259b5258339b42db7867af9269e21829ea78cc
ARG TAILSCALE_ARM64_SHA256=a27249bc70d7b37a68f8be7f5c4507ea5f354e592dce43cb5d4f3e742b313c3c
RUN set -eu; \
    apk add --no-cache curl sudo; \
    ARCH=$(uname -m); \
    case "$ARCH" in \
      x86_64)  TS_ARCH=amd64; EXPECTED="$TAILSCALE_AMD64_SHA256" ;; \
      aarch64) TS_ARCH=arm64; EXPECTED="$TAILSCALE_ARM64_SHA256" ;; \
      *) echo "Unsupported architecture: $ARCH" >&2; exit 1 ;; \
    esac; \
    curl -fsSL "https://pkgs.tailscale.com/stable/tailscale_${TAILSCALE_VERSION}_${TS_ARCH}.tgz" -o /tmp/tailscale.tgz; \
    echo "${EXPECTED}  /tmp/tailscale.tgz" | sha256sum -c -; \
    tar -xzf /tmp/tailscale.tgz -C /usr/local/bin --strip-components=1; \
    rm /tmp/tailscale.tgz; \
    echo "appuser ALL=(ALL) NOPASSWD: /usr/local/bin/tailscale" > /etc/sudoers.d/appuser

WORKDIR /app

COPY target/ai-automation-backend-*.jar app.jar

RUN mkdir -p /app/data /app/data/logs && chown -R appuser:appuser /app/data

USER appuser

EXPOSE 9090

HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
    CMD curl -f http://localhost:9090/api/v1/system/health || exit 1

ENTRYPOINT ["java", \
    "-XX:+UseZGC", \
    "-XX:+ZGenerational", \
    "-Xms256m", \
    "-Xmx1g", \
    "-XX:+HeapDumpOnOutOfMemoryError", \
    "-XX:HeapDumpPath=/app/data/logs/", \
    "-XX:ErrorFile=/app/data/logs/hs_err_pid%p.log", \
    "-XX:+ExitOnOutOfMemoryError", \
    "-jar", "app.jar"]
