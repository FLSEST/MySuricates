FROM eclipse-temurin:21-jre-alpine

RUN adduser -D -u 1000 appuser

# Install tailscale and sudo (optional, for remote access)
RUN apk add --no-cache curl sudo && \
    curl -fsSL https://pkgs.tailscale.com/stable/tailscale_latest_amd64.tgz -o /tmp/tailscale.tgz && \
    tar -xzf /tmp/tailscale.tgz -C /usr/local/bin --strip-components=1 && \
    rm /tmp/tailscale.tgz && \
    echo "appuser ALL=(ALL) NOPASSWD: /usr/local/bin/tailscale" > /etc/sudoers.d/appuser \
    || true

WORKDIR /app

COPY target/ai-automation-backend-*.jar app.jar

RUN mkdir -p /app/data && chown appuser:appuser /app/data

USER appuser

EXPOSE 9090

HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
    CMD curl -f http://localhost:9090/api/v1/system/health || exit 1

ENTRYPOINT ["java", \
    "-XX:+UseZGC", \
    "-XX:+ZGenerational", \
    "-Xms256m", \
    "-Xmx1g", \
    "-jar", "app.jar"]
