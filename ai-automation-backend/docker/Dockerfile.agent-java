FROM eclipse-temurin:21-jdk-jammy

# Create generic agent user - UID is overridden at runtime via --user
RUN useradd -m -u 1000 agent

# Base tools + Maven + LibreOffice (headless DOCX -> PDF conversion)
RUN apt-get update && apt-get install -y --no-install-recommends \
      maven git curl jq bash python3 ca-certificates \
      libreoffice-writer libreoffice-core fonts-liberation fonts-dejavu && \
    rm -rf /var/lib/apt/lists/*

# Prepare home directories (m2 cache writable by any runtime UID)
RUN mkdir -p /home/agent/.m2 /home/agent/.cache /home/agent/.config && \
    chown -R agent:agent /home/agent && \
    chmod -R a+rwX /home/agent

ENV HOME="/home/agent"

USER agent
WORKDIR /workspace

# Identity of this Dockerfile for the container overview (TODO 244e5de5): scripts/build-agent-images.sh
# passes its sha256, the backend compares it with its catalog (agent-images.json). Last, so a change
# above still reuses the cached layers; a plain `docker compose build` leaves it empty (shown as unlabeled).
ARG DOCKERFILE_SHA256=
LABEL org.mysuricates.dockerfile-sha256=$DOCKERFILE_SHA256
CMD ["tail", "-f", "/dev/null"]
