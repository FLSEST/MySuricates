FROM ubuntu:24.04

# Create generic agent user - UID is overridden at runtime via --user
# Ubuntu 24.04 ships with UID 1000 (ubuntu user), so remove it first
RUN userdel -r ubuntu 2>/dev/null; useradd -m -u 1000 agent

# Install base tools
RUN apt-get update && apt-get install -y --no-install-recommends \
    git curl jq bash python3 ca-certificates gnupg && \
    rm -rf /var/lib/apt/lists/*

# gitleaks — pinned version + SHA256 verification (release artefact)
ARG GITLEAKS_VERSION=8.30.1
ARG GITLEAKS_LINUX_X64_SHA256=551f6fc83ea457d62a0d98237cbad105af8d557003051f41f3e7ca7b3f2470eb
ARG GITLEAKS_LINUX_ARM64_SHA256=e4a487ee7ccd7d3a7f7ec08657610aa3606637dab924210b3aee62570fb4b080
RUN set -eu; \
    ARCH=$(dpkg --print-architecture); \
    case "$ARCH" in \
      amd64) GL_ARCH=x64; EXPECTED="$GITLEAKS_LINUX_X64_SHA256" ;; \
      arm64) GL_ARCH=arm64; EXPECTED="$GITLEAKS_LINUX_ARM64_SHA256" ;; \
      *) echo "Unsupported architecture: $ARCH" >&2; exit 1 ;; \
    esac; \
    curl -fsSL "https://github.com/gitleaks/gitleaks/releases/download/v${GITLEAKS_VERSION}/gitleaks_${GITLEAKS_VERSION}_linux_${GL_ARCH}.tar.gz" \
      -o /tmp/gitleaks.tar.gz; \
    echo "${EXPECTED}  /tmp/gitleaks.tar.gz" | sha256sum -c -; \
    tar -xzf /tmp/gitleaks.tar.gz -C /usr/local/bin gitleaks; \
    chmod +x /usr/local/bin/gitleaks; \
    rm /tmp/gitleaks.tar.gz

# trivy — pinned binary release (replaces curl|sh from main branch); checksums from the release's
# trivy_<version>_checksums.txt. Checked on 2026-09-24: gitleaks 8.30.1 is the latest release, trivy
# went from 0.70.0 to 0.74.0 (97e1529d).
ARG TRIVY_VERSION=0.74.0
ARG TRIVY_LINUX_X64_SHA256=2ae6fe3ee734b7fdf11335663e18c75ea12dccc76062f09f164a3b0f8be4371a
ARG TRIVY_LINUX_ARM64_SHA256=b94ce1976bbf3c15b514b605ee88be7c6d94a29be2302847ff01cb794d47aad5
RUN set -eu; \
    ARCH=$(dpkg --print-architecture); \
    case "$ARCH" in \
      amd64) TR_ARCH=64bit; EXPECTED="$TRIVY_LINUX_X64_SHA256" ;; \
      arm64) TR_ARCH=ARM64; EXPECTED="$TRIVY_LINUX_ARM64_SHA256" ;; \
      *) echo "Unsupported architecture: $ARCH" >&2; exit 1 ;; \
    esac; \
    curl -fsSL "https://github.com/aquasecurity/trivy/releases/download/v${TRIVY_VERSION}/trivy_${TRIVY_VERSION}_Linux-${TR_ARCH}.tar.gz" \
      -o /tmp/trivy.tar.gz; \
    echo "${EXPECTED}  /tmp/trivy.tar.gz" | sha256sum -c -; \
    tar -xzf /tmp/trivy.tar.gz -C /usr/local/bin trivy; \
    chmod +x /usr/local/bin/trivy; \
    rm /tmp/trivy.tar.gz

# Third-party APT repos (GitHub CLI, Docker) come last and never solely from an old layer cache: a
# build once took the gh layer with its months-old keyring from the cache, and only the next layer's
# `apt-get update` failed on NO_PUBKEY although the current keyring was fine (97e1529d). A new
# APT_REFRESH value (docker-compose.yml: AGENT_APT_REFRESH, e.g. the month) rebuilds from here on.
ARG APT_REFRESH=

# GitHub CLI (gh) — official APT repo
RUN echo "APT_REFRESH=${APT_REFRESH:-unset}" && \
    mkdir -p /etc/apt/keyrings && \
    curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg \
      -o /etc/apt/keyrings/githubcli-archive-keyring.gpg && \
    chmod go+r /etc/apt/keyrings/githubcli-archive-keyring.gpg && \
    echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" \
      > /etc/apt/sources.list.d/github-cli.list && \
    apt-get update && apt-get install -y gh && \
    rm -rf /var/lib/apt/lists/*

# Docker CE CLI only (no daemon)
RUN install -m 0755 -d /etc/apt/keyrings && \
    curl -fsSL https://download.docker.com/linux/ubuntu/gpg -o /etc/apt/keyrings/docker.asc && \
    chmod a+r /etc/apt/keyrings/docker.asc && \
    echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.asc] https://download.docker.com/linux/ubuntu noble stable" \
      > /etc/apt/sources.list.d/docker.list && \
    apt-get update && apt-get install -y --no-install-recommends docker-ce-cli && \
    rm -rf /var/lib/apt/lists/*

# Prepare home directories
RUN mkdir -p /home/agent/.cache /home/agent/.config && \
    chown -R agent:agent /home/agent

ENV HOME="/home/agent"

USER agent
WORKDIR /workspace

CMD ["tail", "-f", "/dev/null"]
