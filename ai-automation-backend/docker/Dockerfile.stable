FROM eclipse-temurin:21-jre-jammy

RUN apt-get update && \
    apt-get install -y --no-install-recommends curl git gosu && \
    rm -rf /var/lib/apt/lists/*

RUN groupadd -g 1000 appuser && \
    useradd -u 1000 -g appuser -m appuser

WORKDIR /app

COPY target/ai-automation-backend-*.jar app.jar
COPY docker/entrypoint.sh /app/entrypoint.sh

RUN mkdir -p /app/data /app/data/logs /app/frontend && \
    chown -R appuser:appuser /app && \
    chmod +x /app/entrypoint.sh

EXPOSE 9091

HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
    CMD curl -f http://localhost:9091/api/v1/system/health || exit 1

ENTRYPOINT ["/app/entrypoint.sh"]
CMD ["java", "-XX:+UseZGC", "-XX:+ZGenerational", "-Xms256m", "-Xmx1g", \
     "-Djava.awt.headless=true", \
     "-XX:+HeapDumpOnOutOfMemoryError", "-XX:HeapDumpPath=/app/data/logs/", \
     "-XX:ErrorFile=/app/data/logs/hs_err_pid%p.log", \
     "-XX:+ExitOnOutOfMemoryError", \
     "-jar", "app.jar"]
