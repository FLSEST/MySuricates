FROM eclipse-temurin:21-jre-jammy

ARG HOST_USER
ARG HOST_UID=1000
ARG HOST_GID=1000
ARG HOST_HOME

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
      curl git gosu \
      python3 jq \
      nodejs npm \
      wget unzip ca-certificates gnupg && \
    rm -rf /var/lib/apt/lists/*

# Docker CE CLI so the backend can spawn ephemeral per-block containers via
# ContainerShellService (container_image in shell/retry/foreach/while/switch blocks).
# The docker daemon lives on the host; we just need the client binary + socket mount.
RUN install -m 0755 -d /etc/apt/keyrings && \
    curl -fsSL https://download.docker.com/linux/ubuntu/gpg -o /etc/apt/keyrings/docker.asc && \
    chmod a+r /etc/apt/keyrings/docker.asc && \
    echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.asc] https://download.docker.com/linux/ubuntu jammy stable" \
      > /etc/apt/sources.list.d/docker.list && \
    apt-get update && apt-get install -y --no-install-recommends docker-ce-cli && \
    rm -rf /var/lib/apt/lists/*

RUN groupadd -g ${HOST_GID} ${HOST_USER} && \
    useradd -u ${HOST_UID} -g ${HOST_USER} -m -d ${HOST_HOME} -s /bin/bash ${HOST_USER}

# Pre-create CLI runtime directories
RUN mkdir -p ${HOST_HOME}/.claude ${HOST_HOME}/.local/bin ${HOST_HOME}/.local/share/claude && \
    chown -R ${HOST_USER}:${HOST_USER} ${HOST_HOME}

WORKDIR /app

COPY target/ai-automation-backend-*.jar app.jar
COPY docker/entrypoint.sh /app/entrypoint.sh

RUN mkdir -p /app/data /app/data/logs /app/frontend && \
    chown -R ${HOST_USER}:${HOST_USER} /app && \
    chmod +x /app/entrypoint.sh

# PATH for Claude CLI
ENV PATH="${HOST_HOME}/.local/bin:${PATH}"

# Pass username to entrypoint
ENV APP_USER=${HOST_USER}

EXPOSE 9091

HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
    CMD curl -f http://localhost:9091/api/v1/system/health || exit 1

ENTRYPOINT ["/app/entrypoint.sh"]
CMD ["java", "-XX:+UseZGC", "-XX:+ZGenerational", "-Xms256m", "-Xmx1g", \
     "-Djava.awt.headless=true", \
     "-XX:+HeapDumpOnOutOfMemoryError", "-XX:HeapDumpPath=/app/data/logs/", \
     "-XX:ErrorFile=/app/data/logs/hs_err_pid%p.log", \
     "-XX:+ExitOnOutOfMemoryError", \
     "-jar", "app.jar"]
