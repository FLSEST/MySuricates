FROM eclipse-temurin:21-jre-jammy

ARG HOST_USER
ARG HOST_UID=1000
ARG HOST_GID=1000
ARG HOST_HOME

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
      curl git gosu \
      python3 jq \
      wget unzip ca-certificates gnupg && \
    rm -rf /var/lib/apt/lists/*

# Node aus dem NodeSource-Repo statt aus Ubuntu jammy: dessen `nodejs`-Paket ist v12.22 und damit
# zu alt fuer zwei der drei KI-CLIs — codex verlangt >=16, pi >=20.6, beide sind ES-Module und
# scheitern unter v12 im Modul-Loader. Genau daran lag es, dass Claude im Container lief und Codex
# und Pi nicht (TODO a1236a64). Die JVM-Anwendung selbst benutzt Node nicht.
ARG NODE_MAJOR=22
RUN install -m 0755 -d /etc/apt/keyrings && \
    curl -fsSL https://deb.nodesource.com/gpgkey/nodesource-repo.gpg.key \
      | gpg --dearmor -o /etc/apt/keyrings/nodesource.gpg && \
    chmod a+r /etc/apt/keyrings/nodesource.gpg && \
    echo "deb [signed-by=/etc/apt/keyrings/nodesource.gpg] https://deb.nodesource.com/node_${NODE_MAJOR}.x nodistro main" \
      > /etc/apt/sources.list.d/nodesource.list && \
    apt-get update && apt-get install -y --no-install-recommends nodejs && \
    rm -rf /var/lib/apt/lists/* && \
    node --version

# Docker CE CLI so the backend can spawn ephemeral per-block containers via
# ContainerShellService (container_image in shell/retry/foreach/while/switch blocks).
# The docker daemon lives on the host; we just need the client binary + socket mount.
RUN install -m 0755 -d /etc/apt/keyrings && \
    curl -fsSL https://download.docker.com/linux/ubuntu/gpg -o /etc/apt/keyrings/docker.asc && \
    chmod a+r /etc/apt/keyrings/docker.asc && \
    echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.asc] https://download.docker.com/linux/ubuntu jammy stable" \
      > /etc/apt/sources.list.d/docker.list && \
    apt-get update && apt-get install -y --no-install-recommends docker-ce-cli && \
    rm -rf /var/lib/apt/lists/*

# Startdateien von codex und pi verlinken, statt sie als Datei zu mounten. Docker loest einen
# Symlink beim Bind-Mount auf — `/usr/bin/codex` laege dann als echte Datei unter /usr/bin, und
# Node suchte seine Abhaengigkeiten relativ dazu statt im Paketverzeichnis. Genau daran scheiterten
# beide ("Missing optional dependency @openai/codex-linux-x64", "Cannot find package 'undici'"),
# obwohl die Pakete gemountet waren. Zeigt der Link ins Leere, ist der Provider eben nicht
# verfuegbar — das schadet nicht (TODO a1236a64).
ARG NODE_MODULES_DIR=/usr/lib/node_modules
RUN ln -sf ${NODE_MODULES_DIR}/@openai/codex/bin/codex.js /usr/local/bin/codex && \
    ln -sf ${NODE_MODULES_DIR}/@earendil-works/pi-coding-agent/dist/cli.js /usr/local/bin/pi

RUN groupadd -g ${HOST_GID} ${HOST_USER} && \
    useradd -u ${HOST_UID} -g ${HOST_USER} -m -d ${HOST_HOME} -s /bin/bash ${HOST_USER}

# Pre-create CLI runtime directories
RUN mkdir -p ${HOST_HOME}/.claude ${HOST_HOME}/.local/bin ${HOST_HOME}/.local/share/claude && \
    chown -R ${HOST_USER}:${HOST_USER} ${HOST_HOME}

WORKDIR /app

COPY target/ai-automation-backend-*.jar app.jar
COPY docker/entrypoint.sh /app/entrypoint.sh

RUN mkdir -p /app/data /app/data/logs /app/frontend /app/secrets && \
    chown -R ${HOST_USER}:${HOST_USER} /app && \
    chmod +x /app/entrypoint.sh

# PATH for Claude CLI
ENV PATH="${HOST_HOME}/.local/bin:${PATH}"

# Pass username to entrypoint
ENV APP_USER=${HOST_USER}

EXPOSE 9091

# --noproxy '*': Docker passes proxy variables into the container, and curl sends localhost through them
# too — the check failed at the proxy and the container never became healthy (cf662c01)
HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
    CMD curl --noproxy '*' -f http://localhost:9091/api/v1/system/health || exit 1

ENTRYPOINT ["/app/entrypoint.sh"]
CMD ["java", "-XX:+UseZGC", "-XX:+ZGenerational", "-Xms256m", "-Xmx1g", \
     "-Djava.awt.headless=true", \
     "-XX:+HeapDumpOnOutOfMemoryError", "-XX:HeapDumpPath=/app/data/logs/", \
     "-XX:ErrorFile=/app/data/logs/hs_err_pid%p.log", \
     "-XX:+ExitOnOutOfMemoryError", \
     "-jar", "app.jar"]
