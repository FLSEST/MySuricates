<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.4.13</version>
        <relativePath/>
    </parent>

    <groupId>com.automation</groupId>
    <artifactId>ai-automation-backend</artifactId>
    <version>0.7.5-SNAPSHOT</version>
    <name>MySuricates Backend</name>
    <description>MySuricates - AI Workflow Automation</description>

    <properties>
        <java.version>21</java.version>
        <maven.build.timestamp.format>yyyy-MM-dd'T'HH:mm:ss'Z'</maven.build.timestamp.format>
        <mapstruct.version>1.5.5.Final</mapstruct.version>
        <docker-java.version>3.4.1</docker-java.version>
        <sqlite-jdbc.version>3.50.3.0</sqlite-jdbc.version>
        <sqlite-dialect.version>0.1.4</sqlite-dialect.version>
        <tika.version>3.3.0</tika.version>
    </properties>

    <dependencies>
        <!-- Spring Boot Starters -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-websocket</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <!-- SQLite -->
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
            <version>${sqlite-jdbc.version}</version>
        </dependency>
        <dependency>
            <groupId>org.hibernate.orm</groupId>
            <artifactId>hibernate-community-dialects</artifactId>
        </dependency>

        <!-- Flyway -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>

        <!-- Docker Java Client -->
        <dependency>
            <groupId>com.github.docker-java</groupId>
            <artifactId>docker-java-core</artifactId>
            <version>${docker-java.version}</version>
        </dependency>
        <dependency>
            <groupId>com.github.docker-java</groupId>
            <artifactId>docker-java-transport-zerodep</artifactId>
            <version>${docker-java.version}</version>
        </dependency>

        <!-- MapStruct -->
        <dependency>
            <groupId>org.mapstruct</groupId>
            <artifactId>mapstruct</artifactId>
            <version>${mapstruct.version}</version>
        </dependency>

        <!-- Jackson (included via Spring Boot, but explicit for JSON type handling) -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>

        <!-- Apache Tika — document text extraction (pure Java, no native deps) -->
        <dependency>
            <groupId>org.apache.tika</groupId>
            <artifactId>tika-core</artifactId>
            <version>${tika.version}</version>
        </dependency>
        <dependency>
            <groupId>org.apache.tika</groupId>
            <artifactId>tika-parser-pdf-module</artifactId>
            <version>${tika.version}</version>
        </dependency>
        <dependency>
            <groupId>org.apache.tika</groupId>
            <artifactId>tika-parser-microsoft-module</artifactId>
            <version>${tika.version}</version>
        </dependency>
        <dependency>
            <groupId>org.apache.tika</groupId>
            <artifactId>tika-parser-text-module</artifactId>
            <version>${tika.version}</version>
        </dependency>
        <dependency>
            <groupId>org.apache.tika</groupId>
            <artifactId>tika-parser-html-module</artifactId>
            <version>${tika.version}</version>
        </dependency>

        <!-- Lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Test Dependencies -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Compile-time API for the LauncherSessionListener that gives each test JVM
             its own SQLite integration DB (see IntegrationTestDbSessionListener). -->
        <dependency>
            <groupId>org.junit.platform</groupId>
            <artifactId>junit-platform-launcher</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <jvmArguments>
                        -XX:+HeapDumpOnOutOfMemoryError
                        -XX:HeapDumpPath=./data/logs/
                        -XX:ErrorFile=./data/logs/hs_err_pid%p.log
                    </jvmArguments>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <source>21</source>
                    <target>21</target>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                        <path>
                            <groupId>org.mapstruct</groupId>
                            <artifactId>mapstruct-processor</artifactId>
                            <version>${mapstruct.version}</version>
                        </path>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok-mapstruct-binding</artifactId>
                            <version>0.2.0</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>

            <!--
                Resolve byte-buddy-agent jar path into a property so Surefire can
                pre-attach it via -javaagent. Required by Mockito inline-mock-maker
                to silence the self-attach deprecation warning under JDK 21+.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <execution>
                        <id>resolve-test-agent-paths</id>
                        <goals>
                            <goal>properties</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <argLine>-javaagent:${net.bytebuddy:byte-buddy-agent:jar}</argLine>
                    <!--
                        Test runs must be reproducible from the classpath alone.
                        Spring Boot's DEFAULT spring.config.location also contains
                        "optional:file:./" and "optional:file:./config/", and Surefire forks the
                        test JVM with the module directory (ai-automation-backend/) as working
                        directory — so the untracked developer config
                        ai-automation-backend/config/application.yml silently joined every local
                        test run and made it measure a different configuration than CI
                        (7 failures in ModuleGuard/ModuleUiToggleIntegrationTest, TODO 39e55535).
                        Pinning the location to the two classpath entries drops exactly the
                        filesystem half of the default and keeps application.yml plus the
                        profile-specific application-<profile>.yml working.
                        Passed as a system property, NOT via argLine: the argLine above wins over
                        any -DargLine, and systemPropertyVariables composes cleanly with it.
                        Guarded by ExternalConfigIsolationTest.
                    -->
                    <systemPropertyVariables>
                        <spring.config.location>optional:classpath:/,optional:classpath:/config/</spring.config.location>
                    </systemPropertyVariables>
                </configuration>
            </plugin>

            <!--
                Single-source the docs the assistant reads at runtime.
                Source of truth: repo-root docs/. These four files are copied into
                src/main/resources/docs (git-ignored) during generate-resources, then the
                default process-resources step bundles them onto the classpath
                (AssistantFetchService loads them via ClassPathResource("docs/...")).
                Prevents silent drift between docs/ and the former resources/ duplicate.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <executions>
                    <execution>
                        <id>sync-docs-from-source</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.basedir}/src/main/resources/docs</outputDirectory>
                            <overwrite>true</overwrite>
                            <resources>
                                <resource>
                                    <directory>${project.basedir}/../docs</directory>
                                    <includes>
                                        <include>architektur.md</include>
                                        <include>WORKFLOW-GUIDE.md</include>
                                        <include>audit-workflow-protocol.md</include>
                                        <include>assistant-system.md</include>
                                        <include>vision.md</include>
                                    </includes>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!--
                Wirft die Integration-Test-DB unter /tmp vor jedem Test-Lauf weg.
                Hintergrund: application-integration.yml nutzt eine file-basierte SQLite-DB,
                die zwischen Läufen persistiert (gewollt, damit Flyway eine eigene Connection
                aufbauen kann). Wird ein Test-Lauf gewaltsam beendet (kill -9, OOM, Reboot),
                bleibt die WAL/Pages inkonsistent zurück und der nächste Bootstrap scheitert
                mit SQLITE_CORRUPT. Phase process-test-resources läuft vor test/integration-test.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-clean-plugin</artifactId>
                <executions>
                    <execution>
                        <id>clean-integration-test-db</id>
                        <phase>process-test-resources</phase>
                        <goals>
                            <goal>clean</goal>
                        </goals>
                        <configuration>
                            <excludeDefaultDirectories>true</excludeDefaultDirectories>
                            <filesets>
                                <fileset>
                                    <directory>/tmp</directory>
                                    <includes>
                                        <include>autotrigger-integrationtest.db</include>
                                        <include>autotrigger-integrationtest.db-shm</include>
                                        <include>autotrigger-integrationtest.db-wal</include>
                                    </includes>
                                </fileset>
                            </filesets>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
            IDE builds (VS Code Java / Eclipse via m2e) must never write into target/:
            the dev backend and Maven share that directory, and the Eclipse compiler
            emits different synthetic classes (no $1 switch-map classes) plus error
            stubs ("Unresolved compilation problems") that poison the running JVM and
            the next `mvn test`. m2e sets the property m2e.version on import, the Maven
            CLI never does — so this profile redirects only IDE builds to target-ide/.
            Incident: 2026-09-13 (three dead scheduled runs, 498 false test errors).
        -->
        <profile>
            <id>ide-eclipse-output</id>
            <activation>
                <property>
                    <name>m2e.version</name>
                </property>
            </activation>
            <build>
                <directory>${project.basedir}/target-ide</directory>
            </build>
        </profile>
    </profiles>
</project>
