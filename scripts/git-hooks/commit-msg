#!/usr/bin/env bash
#
# Check commit message and author address before the commit is created — the same rules
# the pre-push gate later applies to the whole push range. Here the finding is
# cheap (change the message), at push time it can only be fixed by amend or rebase.
#
# Rules: scripts/lib/hygiene-rules.sh — logic: scripts/ci/pre-push-checks.sh
# Bypass: git commit --no-verify — no bypass by reflex.
#
set -uo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
GATE="$REPO_ROOT/scripts/ci/pre-push-checks.sh"

if [ ! -f "$GATE" ]; then
  echo "Hinweis: $GATE fehlt — Nachrichten-Check uebersprungen." >&2
  exit 0
fi

exec bash "$GATE" --message-file "$1"
