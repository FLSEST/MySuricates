#!/usr/bin/env bash
#
# Pre-push gate — checks the commits that are about to leave the repository:
# author address, commit messages, newly added content, doc gates, build check.
# The refs come from git on stdin and are passed on unchanged.
#
# Rules: scripts/lib/hygiene-rules.sh — logic: scripts/ci/pre-push-checks.sh
# Skipping (is reported): MYSURICATES_PREPUSH_SKIP=tree,build git push
# Changed exception files (.gitleaksignore, hygiene rules, gate, hooks, ci.yml): after review,
# release for exactly this state: MYSURICATES_PREPUSH_ALLOW_RULES=<sha> git push
# Bypass: git push --no-verify — no bypass by reflex.
#
set -uo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
GATE="$REPO_ROOT/scripts/ci/pre-push-checks.sh"

if [ ! -f "$GATE" ]; then
  echo "Hinweis: $GATE fehlt — Pre-Push-Gate uebersprungen." >&2
  exit 0
fi

exec bash "$GATE" --hook
