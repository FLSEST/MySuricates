#!/usr/bin/env bash
#
# Pre-commit hygiene check
#
# Blocks commits that NEWLY introduce:
#   1. staged files that fall under an ignore rule
#   2. staged backup files (*.bak, *.bak-<timestamp>, *.orig, ...)
#   3. forbidden literals in added lines
#
# Checks ONLY staged changes — existing violations in unchanged files
# block nothing. The full tree check runs in CI with
# scripts/ci/public-hygiene.sh --tracked.
#
# Rules and lists are in scripts/lib/hygiene-rules.sh and are read by hook
# and CI together — previously they were duplicated verbatim in both files.
#
# Bypass: git commit --no-verify
#
set -uo pipefail

# Repo root from the hook path (scripts/git-hooks/pre-commit), not from git — see
# scripts/ci/public-hygiene.sh on GIT_DIR in worktrees.
REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
GATE="$REPO_ROOT/scripts/ci/public-hygiene.sh"

if [ ! -f "$GATE" ]; then
  echo "Hinweis: $GATE fehlt — Hygiene-Check uebersprungen." >&2
  exit 0
fi

exec bash "$GATE" --staged
