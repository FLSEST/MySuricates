#!/usr/bin/env bash
#
# Pre-commit Hygiene-Check
#
# Blockiert Commits, die NEU einfuehren:
#   1. gestagte Dateien, die unter eine Ignore-Regel fallen
#   2. gestagte Sicherungsdateien (*.bak, *.bak-<zeitstempel>, *.orig, ...)
#   3. verbotene Literale in hinzugefuegten Zeilen
#
# Prueft NUR staged changes — bestehende Verstoesse in unveraenderten Dateien
# blockieren nichts. Der vollstaendige Tree-Check laeuft in der CI mit
# scripts/ci/public-hygiene.sh --tracked.
#
# Regeln und Listen stehen in scripts/lib/hygiene-rules.sh und werden von Hook
# und CI gemeinsam gelesen — vorher standen sie wortgleich in beiden Dateien.
#
# Bypass: git commit --no-verify
#
set -uo pipefail

# Repo-Wurzel aus dem Hook-Pfad (scripts/git-hooks/pre-commit), nicht aus git — siehe
# scripts/ci/public-hygiene.sh zu GIT_DIR in Worktrees.
REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
GATE="$REPO_ROOT/scripts/ci/public-hygiene.sh"

if [ ! -f "$GATE" ]; then
  echo "Hinweis: $GATE fehlt — Hygiene-Check uebersprungen." >&2
  exit 0
fi

exec bash "$GATE" --staged
