{
  "name": {
    "de": "LernApp Test Monitor",
    "en": "LernApp Test Monitor"
  },
  "description": {
    "de": "Führt alle LernApp Playwright-Tests aus. Bei Fehlern wird automatisch ein HIGH-Priority-TODO angelegt (via gate_status: RED).",
    "en": "Runs all LernApp Playwright tests. Creates a HIGH-priority TODO automatically on failure (via gate_status: RED)."
  },
  "icon": "🧪",
  "category": "CUSTOM",
  "tags": [
    "testing",
    "lernapp",
    "playwright",
    "quality-gate"
  ],
  "blocks": [
    {
      "type": "shell",
      "name": "lernapp-tests",
      "config": {
        "command": "npm test",
        "checked_command": true,
        "check_category": "lernapp-tests",
        "on_failure": "continue",
        "timeout_seconds": 1800,
        "workspace": {
          "mode": "isolated",
          "source": "commit",
          "install_npm": true
        }
      }
    }
  ],
  "version": "1.1.1",
  "author": "MySuricates",
  "defaultContext": {
    "project_path": "/home/flo/Entwicklung/LernApp"
  },
  "metadata": {
    "workspace": {
      "mode": "isolated",
      "source": "commit",
      "install_npm": true
    }
  }
}
