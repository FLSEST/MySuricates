{
  "name": {
    "de": "Website Build Gate",
    "en": "Website Build Gate"
  },
  "description": {
    "de": "Prüft Next.js Website: Lint und Production Build — blockiert Release bei Build-Fehlern",
    "en": "Validates Next.js website: lint and production build — blocks release on build failures"
  },
  "icon": "🌐",
  "category": "CUSTOM",
  "tags": [
    "quality-gate",
    "nextjs",
    "web",
    "release"
  ],
  "blocks": [
    {
      "type": "shell",
      "name": "web-lint",
      "config": {
        "command": "npm run lint",
        "checked_command": true,
        "check_category": "web-lint",
        "on_failure": "continue",
        "timeout_seconds": 1800,
        "workspace": {
          "mode": "isolated",
          "source": "commit",
          "install_npm": true
        }
      }
    },
    {
      "type": "shell",
      "name": "web-build",
      "config": {
        "command": "npm run build",
        "checked_command": true,
        "check_category": "web-build",
        "on_failure": "continue",
        "timeout_seconds": 1800
      }
    }
  ],
  "version": "1.1.1",
  "author": "MySuricates",
  "defaultContext": {},
  "metadata": {
    "workspace": {
      "mode": "isolated",
      "source": "commit",
      "install_npm": true
    }
  }
}
